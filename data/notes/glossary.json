  "terminology": [
    {
      "term": "W2C",
      "meaning": "Where to cop / where to buy. A request post seeking a Taobao or Yupoo link for an item."
    },
    {
      "term": "QC",
      "meaning": "Quality check. Photos taken by the agent's warehouse (or seller) before shipping, posted to the sub for community verdict."
    },
    {
      "term": "GL",
      "meaning": "Green Light. Verdict on a QC meaning the item is good — proceed to ship."
    },
    {
      "term": "RL",
      "meaning": "Red Light. Verdict on a QC meaning return/refund. (Note: also = Ralph Lauren as a brand.)"
    },
    {
      "term": "TS",
      "meaning": "Trusted Seller. A community-vouched Taobao/Weidian/Yupoo seller listed on a major sub's wiki."
    },
    {
      "term": "Batch",
      "meaning": "A specific factory's production run of an item (e.g., 'OG batch', 'v3 batch', 'PK batch'). Different batches vary in accuracy."
    },
    {
      "term": "Factory",
      "meaning": "The actual manufacturer. Sneaker batches are named by factory (PK, LJR, GP, OWF). For bags, factories are usually anonymous."
    },
    {
      "term": "FOB",
      "meaning": "Free On Board. Slang claim that goods came off the same line as authentic ('factory overrun'). Usually marketing — true FOB is rare."
    },
    {
      "term": "Haul",
      "meaning": "A post showing multiple items received together. The standard celebratory format on FR/RL."
    },
    {
      "term": "Rep",
      "meaning": "Replica. Generic term for a fake item."
    },
    {
      "term": "1:1",
      "meaning": "Claim that a rep is indistinguishable from authentic. Marketing language; top-tier reps realistically hit 95–98%."
    },
    {
      "term": "Super clone / super fake",
      "meaning": "Top-tier rep, especially for watches and jewelry — implies correct movement/materials (e.g., real 18k gold for a Cartier Love)."
    },
    {
      "term": "Finder fee",
      "meaning": "A tip ($1–10 typically) paid to community members or Discord finders who locate hard-to-find Taobao/Yupoo links."
    },
    {
      "term": "Spreadsheet",
      "meaning": "A community-maintained doc of Taobao/Weidian links by brand/item (e.g., FR's CNFans spreadsheet). Default reference for popular streetwear."
    },
    {
      "term": "Haul tax / Reddit tax",
      "meaning": "The price bump TS sellers add on items hyped on Reddit. Same item is often cheaper from non-TS Yupoos at higher QC risk."
    },
    {
      "term": "StockX tax / Goat tax",
      "meaning": "The legit-resale price you avoid by going rep."
    },
    {
      "term": "Yupoo",
      "meaning": "Chinese photo-hosting site (yupoo.com) used by sellers as a free product catalog. Not a marketplace — you buy via Taobao/Weidian/WeChat."
    },
    {
      "term": "Weidian",
      "meaning": "Chinese WeChat-based marketplace. Many sellers list here instead of (or alongside) Taobao."
    },
    {
      "term": "Taobao",
      "meaning": "Alibaba's Chinese consumer marketplace. The primary source for most reps."
    },
    {
      "term": "Agent / shipping agent",
      "meaning": "A service (CNFans, Sugargoo, Kakobuy, Hoobuy, CSSBuy, Superbuy) that buys from Chinese platforms on your behalf and consolidates/ships internationally."
    },
    {
      "term": "Pre-shipment QC",
      "meaning": "Photos the agent takes of your item before international shipping. Almost all agents do this for free; always request it."
    },
    {
      "term": "Consolidation / parcel",
      "meaning": "Combining multiple orders in the agent's warehouse into one international shipment to save on line-haul cost."
    },
    {
      "term": "Line / shipping line",
      "meaning": "A specific carrier route from China to your country (e.g., 'EU sensitive line', 'US E-Express'). Trade off speed, price, and customs aggressiveness."
    },
    {
      "term": "Sensitive line",
      "meaning": "A shipping route that accepts branded/replica goods (less likely to be seized). Usually pricier and slower."
    },
    {
      "term": "DHgate / AliExpress reps",
      "meaning": "Bottom-tier rep platforms. FR/RL generally do not recommend them."
    },
    {
      "term": "PK / LJR / GP / OWF",
      "meaning": "Top sneaker rep factories. PK God, LJR, GP, OWF — each has known accuracy strengths per model."
    },
    {
      "term": "Legit check",
      "meaning": "Authentication post — community evaluating whether a piece (often gifted or secondhand) is real or rep."
    },
    {
      "term": "1-yuan link",
      "meaning": "A Taobao listing priced at 1 yuan as a placeholder. Buyer messages the seller with the SKU and the price is updated to the real amount."
    },
    {
      "term": "Reverse image search",
      "meaning": "Using Taobao image search, 1688 image search, or JadeShip to find a Chinese listing from a Western stock photo or Yupoo album image."
    },
    {
      "term": "JadeShip",
      "meaning": "Community knowledge base + browser extension that auto-converts Yupoo/Reddit/Taobao links to your chosen agent and overlays QC pics."
    }
  ]
}