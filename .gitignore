# --- Dependencies / build outputs ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Local env / IDE ---
.env
.env.local
.env*.local
.DS_Store
.vscode/
.idea/

# --- Tooling state ---
.context/
.playwright-mcp/

# --- Debug screenshots / temp images at repo root ---
# Anything image-shaped at the root is presumed to be a one-off scratch
# capture (browser screenshots, scrape debugging). Real images live under
# data/<source>/images/, public/, or web-next/public/.
/*.jpeg
/*.jpg
/*.png
/*.webp

# --- Per-machine overlays (never commit) ---
# Sensitive contact dictionaries, passwords, and verified phone numbers live in
# *.local.json files alongside their public counterparts. The notes loader
# merges them at runtime if present.
data/notes/*.local.json

# --- Temp scrape dumps at repo root ---
scrape-*.json
prada-album-list.json
prada-y00978-rescrape.json
photo-id-maps.json
origin-maps.json
map-blcg.json
img-card-structure.json
test-output.json
.mcp.json
